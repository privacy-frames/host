{
  "name": "privacy-frames-static-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:production": "npm run build",
    "build:examples": "tsx scripts/build-examples.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts test *.json .github deployment --ignore-unknown",
    "format:check": "prettier --check src scripts test *.json .github deployment --ignore-unknown",
    "serve": "tsx test/serve.ts",
    "test": "npm run test:unit && npm run test:guest",
    "test:unit": "tsx --test test/*.test.ts",
    "test:guest": "npm run test:guest:core && npm run test:contexts && npm run test:policy && npm run test:installation",
    "test:guest:core": "tsx test/guest-engine.ts && tsx test/guest-wasm.ts && tsx test/guest-regexp.ts && tsx test/guest-parser-browser.ts && tsx test/guest-web-services-browser.ts && tsx test/guest-lifecycle.ts",
    "test:contexts": "tsx test/guest-contexts.ts && tsx test/guest-context-isolation.ts && tsx test/guest-context-windows.ts && tsx test/guest-context-maintenance.ts",
    "test:policy": "tsx test/guest-policy.ts && tsx test/guest-examples.ts",
    "test:installation": "tsx test/guest-installation.ts && tsx test/share-links.ts",
    "test:pitch": "tsx test/guest-pitch.ts",
    "test:compatibility": "tsx test/guest-corpus-matrix.ts",
    "test:assets": "tsx test/assets.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@jridgewell/resolve-uri": "3.1.3",
    "@webref/idl": "3.87.0",
    "acorn": "8.19.0",
    "acorn-import-phases": "1.0.4",
    "css-tree": "^3.2.1",
    "es-module-lexer": "^3.0.4",
    "parse5": "8.0.1",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "6.0.0",
    "webidl2": "24.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webidl2": "24.4.4",
    "esbuild": "0.28.2",
    "marked": "^18.1.1",
    "patch-package": "8.0.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
